+#[derive(Clone, Debug)]
+pub struct SopVerificationSettings {
+    pub python: Option<PathBuf>,
+    pub worker: Option<PathBuf>,
+    pub api_key_ref: String,
+    pub model: String,
+}
+
+impl Default for SopVerificationSettings {
+    fn default() -> Self {
+        Self {
+            python: None,
+            worker: None,
+            api_key_ref: "env://DEEPSEEK_API_KEY".into(),
+            model: "deepseek-flash".into(),
+        }
+    }
+}
+
+impl SopVerificationSettings {
+    fn from_env() -> Result<Self> {
+        let path = |name: &str| -> Result<Option<PathBuf>> {
+            let value = env::var_os(name)
+                .filter(|v| !v.is_empty())
+                .map(PathBuf::from);
+            anyhow::ensure!(
+                value.as_ref().is_none_or(|v| v.is_absolute()),
+                "{name} must be an absolute path"
+            );
+            Ok(value)
+        };
+        let mut settings = Self::default();
+        settings.python = path("FORMSY_SOP_VERIFICATION_PYTHON")?;
+        settings.worker = path("FORMSY_SOP_VERIFICATION_WORKER")?;
+        if let Ok(reference) = env::var("FORMSY_SOP_VERIFICATION_API_KEY_REF") {
+            if !reference.is_empty() {
+                anyhow::ensure!(
+                    reference
+                        .strip_prefix("env://")
+                        .is_some_and(|name| !name.is_empty()
+                            && name.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_')),
+                    "FORMSY_SOP_VERIFICATION_API_KEY_REF must use env://NAME"
+                );
+                settings.api_key_ref = reference;
+            }
+        }
+        if let Ok(model) = env::var("FORMSY_SOP_VERIFICATION_MODEL") {
+            if !model.trim().is_empty() {
+                anyhow::ensure!(
+                    model.len() <= 200,
+                    "FORMSY_SOP_VERIFICATION_MODEL is too long"
+                );
+                settings.model = model;
+            }
+        }
+        Ok(settings)
+    }
+}
+
