diff --git a/rust/formsy-server/src/sop_verification/worker.rs b/rust/formsy-server/src/sop_verification/worker.rs
new file mode 100644
index 0000000..311e1f1
--- /dev/null
+++ b/rust/formsy-server/src/sop_verification/worker.rs
@@ -0,0 +1,86 @@
+use super::*;
+use std::{process::Stdio, time::Duration};
+use tokio::{
+    io::{AsyncReadExt, AsyncWriteExt},
+    process::Command,
+};
+
+const MAX_OUTPUT: usize = 1024 * 1024;
+
+pub(super) async fn run(state: &AppState, input: &Value) -> Result<Value, KnowledgeError> {
+    let config = &state.settings.sop_verification;
+    let unavailable = || {
+        KnowledgeError::new(
+            StatusCode::SERVICE_UNAVAILABLE,
+            "sop_verification_unavailable",
+        )
+    };
+    let python = config
+        .python
+        .as_ref()
+        .filter(|p| p.is_absolute() && p.is_file())
+        .ok_or_else(unavailable)?;
+    let worker = config
+        .worker
+        .as_ref()
+        .filter(|p| p.is_absolute() && p.is_file())
+        .ok_or_else(unavailable)?;
+    let key = state
+        .secret_resolver
+        .resolve(&config.api_key_ref)
+        .await
+        .ok_or_else(|| {
+            KnowledgeError::new(
+                StatusCode::SERVICE_UNAVAILABLE,
+                "sop_verification_model_unconfigured",
+            )
+        })?;
+    let mut child = Command::new(python)
+        .arg("-I")
+        .arg(worker)
+        .env_clear()
+        .env("DEEPSEEK_API_KEY", key)
+        .env("DEEPSEEK_MODEL", &config.model)
+        .env("PYTHONIOENCODING", "utf-8")
+        .env("PYTHONUTF8", "1")
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .kill_on_drop(true)
+        .spawn()
+        .map_err(|_| unavailable())?;
+    let bytes = serde_json::to_vec(input).map_err(|_| invalid_worker())?;
+    tokio::time::timeout(Duration::from_secs(120), async {
+        let mut stdin = child.stdin.take().ok_or_else(unavailable)?;
+        let mut stdout = child
+            .stdout
+            .take()
+            .ok_or_else(unavailable)?
+            .take((MAX_OUTPUT + 1) as u64);
+        let mut output = Vec::new();
+        tokio::try_join!(
+            async {
+                stdin.write_all(&bytes).await.map_err(|_| unavailable())?;
+                drop(stdin);
+                Ok::<_, KnowledgeError>(())
+            },
+            async {
+                stdout
+                    .read_to_end(&mut output)
+                    .await
+                    .map_err(|_| unavailable())?;
+                if output.len() > MAX_OUTPUT {
+                    return Err(invalid_worker());
+                }
+                Ok::<_, KnowledgeError>(())
+            }
+        )?;
+        let status = child.wait().await.map_err(|_| unavailable())?;
+        if !status.success() {
+            return Err(invalid_worker());
+        }
+        serde_json::from_slice(&output).map_err(|_| invalid_worker())
+    })
+    .await
+    .map_err(|_| KnowledgeError::new(StatusCode::GATEWAY_TIMEOUT, "sop_verification_timeout"))?
+}
