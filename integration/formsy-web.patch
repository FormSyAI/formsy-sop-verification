diff --git a/components/formsy/sop-verification-panel.tsx b/components/formsy/sop-verification-panel.tsx
new file mode 100644
index 0000000..8439018
--- /dev/null
+++ b/components/formsy/sop-verification-panel.tsx
@@ -0,0 +1,409 @@
+import { useState } from "react";
+import { Select } from "antd";
+import { useQuery } from "@tanstack/react-query";
+import { ApiError } from "@/lib/formsy/api/client";
+import { sopApi } from "@/lib/formsy/api/sop";
+import type { Task } from "@/lib/formsy/api/tasks";
+import type { SopVerificationResult } from "@/lib/formsy/api/sop-verification";
+import { useCurrentUser } from "@/lib/formsy/queries/onboarding";
+import {
+  useCreateSopVerification,
+  useSopVerification,
+  useSopVerifications,
+} from "@/lib/formsy/queries/sop-verification";
+import { formatTimestamp } from "@/lib/formsy/timestamp";
+import {
+  Badge,
+  Button,
+  EmptyState,
+  Field,
+  Input,
+  Notice,
+  SkeletonRows,
+  StatStrip,
+  SurfaceCard,
+  TextLink,
+} from "./shared";
+import { KnowledgeError, knowledgeError } from "./knowledge-ui";
+import { KnowledgeSourceRefs } from "./knowledge-source-refs";
+
+const resultLabels: Record<SopVerificationResult, string> = {
+  satisfied: "满足",
+  unsatisfied: "不满足",
+  unverified: "未核实",
+  not_applicable: "不适用",
+};
+const sectionLabels: Record<string, string> = {
+  goal: "目标与范围",
+  constraints: "规则与约束",
+  behavior: "行为与边界",
+  impact: "技术影响",
+  preparation: "实现准备",
+  acceptance: "完成条件",
+};
+function failureMessage(error: unknown) {
+  if (error instanceof ApiError) {
+    const messages: Record<string, string> = {
+      sop_verification_unavailable: "SOP 核查服务暂不可用，未生成本轮报告。",
+      sop_verification_model_unconfigured: "核查模型尚未配置，未生成报告。",
+      sop_verification_source_incomplete:
+        "绑定来源尚不完整，无法生成完整核查报告。请先检查来源同步与可读状态。",
+      sop_verification_diff_incomplete:
+        "目标 Commit 的差异含二进制文件、缺失补丁或截断内容，本轮未生成报告。请先检查差异可读性。",
+      sop_verification_scope_empty:
+        "所选任务范围没有可核查的来源正文，未生成报告。请检查来源绑定与同步状态。",
+      sop_verification_output_invalid:
+        "核查服务返回的报告未通过契约校验，本轮未保存有效报告。请先检查核查服务。",
+      sop_verification_busy: "核查服务正在处理其他请求，请稍后再发起。",
+      sop_verification_timeout:
+        "本次核查超时，未确认生成结果。请刷新报告记录后再决定是否重新核查。",
+      sop_verification_input_too_large: "任务来源超出本次核查容量。请先缩小任务来源范围。",
+      sop_withdrawn: "这版 SOP 已撤回，不能用于新核查或读取冻结正文。请重新核对项目 SOP。",
+    };
+    if (error.code && messages[error.code]) return messages[error.code];
+  }
+  return `${knowledgeError(error)} 请刷新报告记录确认结果；请求失败不代表核查完成。`;
+}
+
+export function SopVerificationPanel({
+  projectId,
+  task,
+  canEdit,
+}: {
+  projectId: string;
+  task: Task;
+  canEdit: boolean;
+}) {
+  const user = useCurrentUser();
+  const actor = JSON.stringify([user.data?.id, user.data?.active_provider, user.data?.providers]);
+  const effective = useQuery({
+    queryKey: ["sop", actor, projectId, "effective"],
+    queryFn: () => sopApi.effective(projectId),
+    enabled: user.isSuccess,
+    retry: false,
+    refetchOnMount: "always",
+  });
+  const history = useSopVerifications(projectId, task.id, actor, user.isSuccess);
+  const create = useCreateSopVerification(projectId, task.id, actor);
+  const [selectedId, setSelectedId] = useState<string>();
+  const [targetCommit, setTargetCommit] = useState("");
+  const normalizedCommit = targetCommit.trim().toLowerCase();
+  const commitValid = !normalizedCommit || /^[0-9a-f]{40}$/.test(normalizedCommit);
+  const reports = history.data?.pages.flatMap((page) => page.items) ?? [];
+  const activeId = selectedId ?? reports[0]?.id;
+  const detail = useSopVerification(projectId, task.id, actor, activeId, user.isSuccess);
+  const bundle = effective.isError ? null : effective.data?.bundle;
+  const report = detail.isError ? undefined : detail.data;
+  const canGenerate =
+    canEdit &&
+    task.status !== "done" &&
+    Boolean(bundle) &&
+    task.source_bindings.length > 0 &&
+    commitValid;
+  return (
+    <SurfaceCard className="fs-sop-verification">
+      <div className="fs-gate-heading">
+        <h2>SOP 核查 · 候选报告</h2>
+        <Badge tone={report?.status === "failed" ? "danger" : "info"}>
+          {report?.status === "failed" ? "分析失败" : "人工待复核"}
+        </Badge>
+      </div>
+      <div className="fs-gate-content">
+        <Notice>
+          AI 按本次固定的 SOP 和来源生成候选结论，仍需人工复核。报告不会自动记录检查结果或完成任务。
+        </Notice>
+        {effective.isPending && <SkeletonRows count={1} />}
+        {effective.isError && (
+          <KnowledgeError error={effective.error} retry={() => void effective.refetch()} />
+        )}
+        {bundle && (
+          <div>
+            <p>
+              新核查使用项目 SOP v{bundle.version}；来源为本任务绑定的 {task.source_bindings.length}{" "}
+              项范围。
+            </p>
+            <details className="fs-source-identity">
+              <summary>本次规范标识</summary>
+              <p>
+                {bundle.sop_id} · v{bundle.version}
+              </p>
+              <code>{bundle.digest}</code>
+            </details>
+          </div>
+        )}
+        {effective.isSuccess && !bundle && (
+          <Notice tone="warning">
+            项目尚未启用 SOP，暂不能发起核查。
+            <TextLink href={`/projects/${encodeURIComponent(projectId)}/sop`}>
+              查看项目 SOP
+            </TextLink>
+          </Notice>
+        )}
+        {!task.source_bindings.length && (
+          <Notice tone="warning">请先在任务设置中绑定需要核查的会话与轮次范围。</Notice>
+        )}
+        {canEdit && task.status !== "done" && (
+          <div className="fs-sop-verification-action">
+            <Field label="目标 Commit（可选）">
+              <Input
+                aria-label="目标 Commit（可选）"
+                value={targetCommit}
+                onChange={(event) => setTargetCommit(event.target.value)}
+                disabled={create.isPending}
+                maxLength={40}
+                placeholder="填写本项目的 40 位完整 Commit SHA"
+              />
+            </Field>
+            {!commitValid && (
+              <Notice tone="warning">请填写 40 位十六进制完整 Commit SHA，或留空。</Notice>
+            )}
+            {!normalizedCommit && (
+              <p className="fs-task-phase-description">
+                未指定目标 Commit；涉及实际改动覆盖的条件将保留未核实。
+              </p>
+            )}
+            <p className="fs-task-phase-description">
+              点击后，所选任务范围的对话、工具记录及关联证据将发送至 DeepSeek
+              核查，并保存为新一轮候选报告。已有报告保留。
+            </p>
+            <Button
+              disabled={!canGenerate || create.isPending || !effective.isFetchedAfterMount}
+              loading={create.isPending}
+              onClick={() => {
+                if (!bundle) return;
+                create.mutate(
+                  { version: bundle.version, targetCommit: normalizedCommit || undefined },
+                  { onSuccess: (next) => setSelectedId(next.id) },
+                );
+              }}
+            >
+              按 SOP 核查
+            </Button>
+          </div>
+        )}
+        {create.isPending && <Notice>正在读取绑定来源并核查，请等待本次结果。</Notice>}
+        {create.isError && <Notice tone="danger">{failureMessage(create.error)}</Notice>}
+        <div className="fs-source-toolbar">
+          {reports.length > 0 && (
+            <Select
+              className="fs-sop-verification-history"
+              aria-label="选择 SOP 核查报告"
+              value={activeId}
+              onChange={setSelectedId}
+              options={reports.map((item) => ({
+                value: item.id,
+                label: `${formatTimestamp(item.created_at)} · SOP v${item.sop.version} · ${item.status === "failed" ? "分析失败" : "候选报告"}`,
+              }))}
+            />
+          )}
+          <Button disabled={history.isFetching} onClick={() => void history.refetch()}>
+            刷新报告记录
+          </Button>
+          {history.hasNextPage && (
+            <Button
+              loading={history.isFetchingNextPage}
+              onClick={() => void history.fetchNextPage()}
+            >
+              加载更早报告
+            </Button>
+          )}
+        </div>
+        {history.isPending && <SkeletonRows count={2} />}
+        {history.isError && (
+          <KnowledgeError error={history.error} retry={() => void history.refetch()} />
+        )}
+        {history.isSuccess && !reports.length && !create.isPending && !report && (
+          <EmptyState
+            title="尚无 SOP 核查报告"
+            detail="绑定任务来源并发起核查后，在这里查看逐项候选结论和证据。"
+          />
+        )}
+        {activeId && detail.isPending && <SkeletonRows count={3} />}
+        {detail.isError && (
+          <KnowledgeError error={detail.error} retry={() => void detail.refetch()} />
+        )}
+        {report && (
+          <>
+            <p>
+              报告时间：{formatTimestamp(report.created_at)} · 固定 SOP v{report.sop.version} ·
+              {report.status === "failed" ? "分析失败，已保留本轮记录" : "人工未复核"}
+            </p>
+            {report.report.context.target_commit &&
+              /^[0-9a-f]{40}$/i.test(report.report.context.target_commit) && (
+                <p>
+                  固定目标 Commit：
+                  <TextLink
+                    href={`/projects/${encodeURIComponent(projectId)}/commits/${encodeURIComponent(report.report.context.target_commit)}`}
+                  >
+                    {report.report.context.target_commit}
+                  </TextLink>
+                </p>
+              )}
+            {report.status === "failed" && (
+              <Notice tone="danger">
+                本轮分析失败，未得出完整核查结论。修复后可重新核查，失败记录会保留。
+              </Notice>
+            )}
+            <Notice tone="warning">
+              核查范围：{report.report.coverage.mapped_conditions} 个条件，涉及{" "}
+              {report.report.coverage.mapped_sections.length}/
+              {report.report.coverage.total_sections} 章。 未覆盖：
+              {report.report.coverage.unmapped_sections
+                .map((id) => sectionLabels[id] ?? id)
+                .join("、")}
+              。不代表完整 SOP 已满足。
+            </Notice>
+            {report.report.coverage.evidence_completeness !== "complete" && (
+              <Notice tone="warning">
+                本轮来源采集
+                {report.report.coverage.evidence_completeness === "partial"
+                  ? "不完整"
+                  : "完整性未知"}
+                。局部正面证据不能证明完整要求已满足。
+              </Notice>
+            )}
+            {!report.report.analysis_complete && (
+              <Notice tone="warning">本轮分析未完整完成；请结合下方缺口与原始证据复核。</Notice>
+            )}
+            <details className="fs-source-identity">
+              <summary>冻结依据与报告标识</summary>
+              <dl>
+                <div>
+                  <dt>报告</dt>
+                  <dd>{report.id}</dd>
+                </div>
+                <div>
+                  <dt>SOP 摘要</dt>
+                  <dd>
+                    <code>{report.sop.digest}</code>
+                  </dd>
+                </div>
+                <div>
+                  <dt>输入摘要</dt>
+                  <dd>
+                    <code>{report.input_digest}</code>
+                  </dd>
+                </div>
+                <div>
+                  <dt>核查条件映射</dt>
+                  <dd>
+                    {report.report.coverage.profile_id} · {report.report.coverage.mapping_revision}
+                  </dd>
+                </div>
+              </dl>
+              <p>修改来源或 SOP 后重新核查会产生新报告，历史结论保留本轮依据。</p>
+              {report.report.analysis_errors.length > 0 && (
