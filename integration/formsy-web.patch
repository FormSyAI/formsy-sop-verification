@@ -0,0 +1,49 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { sopVerificationApi } from "../lib/formsy/api/sop-verification.ts";
+import { setCsrfToken } from "../lib/formsy/api/client.ts";
+
+test("SOP verification writes only a pinned candidate request and keeps history addresses separate", async () => {
+  const beforeFetch = globalThis.fetch;
+  const beforeWindow = globalThis.window;
+  const calls = [];
+  globalThis.window = { location: { origin: "https://formsy.test" }, setTimeout, clearTimeout };
+  setCsrfToken("verification-csrf");
+  globalThis.fetch = async (url, options) => {
+    calls.push({
+      url,
+      method: options.method ?? "GET",
+      body: options.body ? JSON.parse(options.body) : undefined,
+      csrf: options.headers.get("X-CSRF-Token"),
+      credentials: options.credentials,
+    });
+    return new Response(JSON.stringify({}), { headers: { "Content-Type": "application/json" } });
+  };
+  try {
+    await sopVerificationApi.list("project/a", "task/a", 25);
+    await sopVerificationApi.get("project/a", "task/a", "old/report");
+    await sopVerificationApi.create("project/a", "task/a", 7);
+    await sopVerificationApi.create("project/a", "task/a", 7, "b".repeat(40));
+    assert.equal(
+      calls[0].url,
+      "/api/v1/projects/project%2Fa/tasks/task%2Fa/sop-verifications?limit=25&offset=25",
+    );
+    assert.equal(
+      calls[1].url,
+      "/api/v1/projects/project%2Fa/tasks/task%2Fa/sop-verifications/old%2Freport",
+    );
+    assert.deepEqual(calls[2].body, { sop_version: 7 });
+    assert.equal(calls[2].method, "POST");
+    assert.equal(calls[2].csrf, "verification-csrf");
+    assert.equal(calls[2].credentials, "include");
+    assert.deepEqual(calls[3].body, { sop_version: 7, target_commit: "b".repeat(40) });
+    assert.equal(
+      calls.some((call) => /\/checks\/|\/complete$/.test(call.url)),
+      false,
+    );
+  } finally {
+    globalThis.fetch = beforeFetch;
+    globalThis.window = beforeWindow;
+    setCsrfToken(null);
+  }
+});
