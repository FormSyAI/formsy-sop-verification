+                <SurfaceCard className="fs-gate-item" key={check.condition_id}>
+                  <div className="fs-section-header">
+                    <h3>{check.title}</h3>
+                    <Badge
+                      tone={
+                        check.result === "unsatisfied"
+                          ? "danger"
+                          : check.result === "unverified"
+                            ? "warning"
+                            : check.result === "not_applicable"
+                              ? "neutral"
+                              : "info"
+                      }
+                    >
+                      候选 · {resultLabels[check.result]}
+                    </Badge>
+                  </div>
+                  <p className="fs-entry-classification">
+                    {check.condition_id} ·{" "}
+                    {sectionLabels[check.source_section_id] ?? check.source_section_id}
+                  </p>
+                  <p className="fs-knowledge-content">参考核查条件：{check.criterion}</p>
+                  <p>判断依据：{check.reason}</p>
+                  {check.sop_refs.length > 0 && (
+                    <details className="fs-source-identity">
+                      <summary>本版 SOP 原文依据</summary>
+                      {check.sop_refs.map((ref, index) => (
+                        <div key={index}>
+                          <small>{ref.pointer}</small>
+                          <pre className="fs-knowledge-source-text">{ref.quote}</pre>
+                        </div>
+                      ))}
+                    </details>
+                  )}
+                  {check.gaps.length > 0 && (
+                    <div>
+                      <strong>缺口与补充建议</strong>
+                      <ul>
+                        {check.gaps.map((gap, index) => (
+                          <li key={index}>{gap}</li>
+                        ))}
+                      </ul>
+                    </div>
+                  )}
+                  {check.validation_errors.length > 0 && (
+                    <Notice tone="warning">
+                      证据校验问题：{check.validation_errors.join("；")}
+                    </Notice>
+                  )}
+                  {check.evidence_refs.map((evidence, index) => (
+                    <details className="fs-source-identity" key={`${evidence.source_id}:${index}`}>
+                      <summary>
+                        引用 {index + 1} · {evidence.source_id} · 第 {evidence.start_line}–
+                        {evidence.end_line} 行
+                      </summary>
+                      <pre className="fs-knowledge-source-text">{evidence.quote}</pre>
+                    </details>
+                  ))}
+                  {check.items.length > 0 && (
+                    <details className="fs-source-identity">
+                      <summary>展开子项判定（{check.items.length}）</summary>
+                      {check.items.map((item) => (
+                        <article className="fs-knowledge-job" key={item.item_id}>
+                          <p>
+                            {item.item_id} · 候选{resultLabels[item.result]}
+                          </p>
+                          <p>{item.criterion}</p>
+                          <p>{item.reason}</p>
+                          {item.evidence_refs.map((evidence, index) => (
+                            <div key={`${evidence.source_id}:${index}`}>
+                              <small>
+                                {evidence.source_id} · 第 {evidence.start_line}–{evidence.end_line}{" "}
+                                行
+                              </small>
+                              <pre className="fs-knowledge-source-text">{evidence.quote}</pre>
+                            </div>
+                          ))}
+                        </article>
+                      ))}
+                    </details>
+                  )}
+                  <div className="fs-gate-item-footer">
+                    <KnowledgeSourceRefs projectId={projectId} refs={refs} locateReferences />
+                    <span className="fs-entry-classification">人工未复核</span>
+                  </div>
+                </SurfaceCard>
+              );
+            })}
+          </>
+        )}
+      </div>
+    </SurfaceCard>
+  );
+}
