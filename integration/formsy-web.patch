@@ -0,0 +1,93 @@
+import { apiRequest } from "./client";
+import type { Page, SourceRef } from "./knowledge";
+
+export type SopVerificationResult = "satisfied" | "unsatisfied" | "unverified" | "not_applicable";
+export type SopVerificationSummary = {
+  result: SopVerificationResult;
+  counts: Record<SopVerificationResult, number>;
+};
+export type SopVerificationEvidence = {
+  source_id: string;
+  start_line: number;
+  end_line: number;
+  quote: string;
+  locator: Record<string, unknown>;
+};
+export type SopVerificationCheck = {
+  condition_id: string;
+  rule_id: string;
+  source_section_id: string;
+  title: string;
+  criterion: string;
+  candidate_result: SopVerificationResult;
+  result: SopVerificationResult;
+  reason: string;
+  gaps: string[];
+  evidence_refs: SopVerificationEvidence[];
+  sop_refs: { pointer: string; quote: string }[];
+  items: {
+    item_id: string;
+    criterion: string;
+    result: SopVerificationResult;
+    reason: string;
+    gaps: string[];
+    evidence_refs: SopVerificationEvidence[];
+  }[];
+  validation_errors: string[];
+  review_state: "model_candidate";
+  human_review: "not_reviewed";
+};
+export type SopVerificationReport = {
+  context: { project_id: string; task_id: string; target_commit?: string };
+  checks: SopVerificationCheck[];
+  summary: SopVerificationSummary;
+  coverage: {
+    profile_id: string;
+    mapping_revision: string;
+    mapped_conditions: number;
+    total_sections: number;
+    mapped_sections: string[];
+    unmapped_sections: string[];
+    complete_sop: false;
+    evidence_completeness: "complete" | "partial" | "unknown";
+  };
+  analysis_complete: boolean;
+  analysis_errors: string[];
+  formal_closed: false;
+};
+export type SopVerification = {
+  id: string;
+  project_id: string;
+  task_id: string;
+  created_by: string;
+  created_at: string;
+  status: "candidate" | "failed";
+  sop: { sop_id: string; version: number; digest: string };
+  input_digest: string;
+  summary: SopVerificationSummary;
+};
+export type SopVerificationDetail = SopVerification & {
+  input_snapshot: unknown;
+  report: SopVerificationReport;
+  source_refs_by_id: Record<string, SourceRef>;
+};
+
+const root = (project: string, task: string) =>
+  `/projects/${encodeURIComponent(project)}/tasks/${encodeURIComponent(task)}/sop-verifications`;
+export const sopVerificationApi = {
+  list: (project: string, task: string, offset: number, signal?: AbortSignal) =>
+    apiRequest<Page<SopVerification>>(root(project, task), {
+      query: { limit: 25, offset },
+      signal,
+    }),
+  get: (project: string, task: string, id: string, signal?: AbortSignal) =>
+    apiRequest<SopVerificationDetail>(`${root(project, task)}/${encodeURIComponent(id)}`, {
+      signal,
+    }),
+  create: (project: string, task: string, sopVersion: number, targetCommit?: string) =>
+    apiRequest<SopVerificationDetail>(root(project, task), {
+      method: "POST",
+      body: { sop_version: sopVersion, ...(targetCommit ? { target_commit: targetCommit } : {}) },
+      timeoutMs: 180_000,
+    }),
+};
diff --git a/lib/formsy/queries/sop-verification.ts b/lib/formsy/queries/sop-verification.ts
new file mode 100644
index 0000000..8ca65f8
--- /dev/null
+++ b/lib/formsy/queries/sop-verification.ts
@@ -0,0 +1,53 @@
+import { useInfiniteQuery, useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { sopVerificationApi } from "../api/sop-verification";
+
+export const sopVerificationKeys = {
+  history: (project: string, task: string, actor: string) =>
+    ["sop-verifications", actor, project, task] as const,
+  detail: (project: string, task: string, actor: string, id: string) =>
+    ["sop-verifications", actor, project, task, id] as const,
+};
+export function useSopVerifications(
+  project: string,
+  task: string,
+  actor: string,
+  enabled: boolean,
+) {
+  return useInfiniteQuery({
+    queryKey: sopVerificationKeys.history(project, task, actor),
+    queryFn: ({ pageParam, signal }) => sopVerificationApi.list(project, task, pageParam, signal),
+    initialPageParam: 0,
+    getNextPageParam: (page) => page.next_offset ?? undefined,
+    enabled,
+    retry: false,
+  });
+}
+export function useSopVerification(
+  project: string,
+  task: string,
+  actor: string,
+  id: string | undefined,
+  enabled: boolean,
+) {
+  return useQuery({
+    queryKey: sopVerificationKeys.detail(project, task, actor, id ?? ""),
+    queryFn: ({ signal }) => sopVerificationApi.get(project, task, id!, signal),
+    enabled: enabled && Boolean(id),
+    retry: false,
+    refetchOnMount: "always",
+  });
+}
+export function useCreateSopVerification(project: string, task: string, actor: string) {
+  const client = useQueryClient();
+  return useMutation({
+    mutationFn: ({ version, targetCommit }: { version: number; targetCommit?: string }) =>
+      sopVerificationApi.create(project, task, version, targetCommit),
+    retry: false,
+    onSuccess: async (detail) => {
+      client.setQueryData(sopVerificationKeys.detail(project, task, actor, detail.id), detail);
+      await client.invalidateQueries({
+        queryKey: sopVerificationKeys.history(project, task, actor),
+      });
+    },
+  });
+}
