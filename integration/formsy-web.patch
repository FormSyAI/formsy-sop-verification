+
+test("部分来源报告明确展示采集边界", async ({ page }) => {
+  await fixture(page, { partial: true });
+  await expect(page.locator(".fs-sop-verification").getByText(/本轮来源采集不完整/)).toBeVisible();
+});
+
+test("读完仍找不到引用时明确提示，不替代成其他记录", async ({ page }) => {
+  await fixture(page, { locateMissing: true });
+  await page
+    .locator(".fs-sop-verification")
+    .getByRole("button", { name: "查看来源（1）", exact: true })
+    .click();
+  const modal = page.getByRole("dialog", { name: "原始来源片段", exact: true });
+  await expect(modal.getByText(/已读完原轮次，仍有 1 项引用未找到/)).toBeVisible();
+  await expect(modal.getByText("无关工具输出", { exact: true })).toHaveCount(0);
+  await expect(modal.getByText(/已定位全部引用/)).toHaveCount(0);
+  await expect(modal.getByRole("button", { name: "阅读原轮次", exact: true })).toBeVisible();
+});
